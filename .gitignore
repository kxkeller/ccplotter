# regenerable / runtime junk
archive/
work/
# runtime directory created in the working directory at import time
dbv3_inbox/
__pycache__/
*.pyc
server.log
*.bak
# D5 correction (g22 REVISE gate, 2026-07-28): this archived original must
# stay tracked -- it is the pre-correction record for
# g21_component_sizes_results.json, not disposable scratch.
!artifacts/grayscale-g0-2026-07-27/g21_component_sizes_results.SUPERSEDED_mixed_provenance.json.bak
assets/templates/index.broken-*.html
server.err.log
golden_server.out.log
comfy*.log
# reorg 2026-07-19: stray logs now collected under logs/ (also gitignored
# wholesale below); old root-level patterns above kept as a safety net in
# case a stray reappears at root.
logs/
.staged/
# secrets - never commit
openai_key.txt
gemini_key.txt
*_key.txt
.env
# further credential/secret patterns (openai_key.txt and *_key.txt are listed above)
*.pem
*.key
.env*
*secret*
*credential*
# misc logs
sigclip*.log*
# desktop build artifacts (regenerable, ~600MB)
build/
dist/
desktop/build.log
# regenerated by desktop/build.ps1 on every build; never hand-edit or commit it
desktop/version.json
*.spec.bak

pen_profiles.json
# ...except the harness's own pinned, hermetic copy (scripts/replay_harness.py,
# 2026-07-31) -- this one is deliberately tracked, not machine-local state.
!scripts/harness_env/pen_profiles.json
# ...and the frozen copy of the author's pen profiles that some tests read as input
# (see tests/fixtures/rot_fix_2026_09_01/_env/README.md).
!tests/fixtures/rot_fix_2026_09_01/_env/pen_profiles.json
# ...and the handoff EXPORT, which is the one copy a fresh machine can bootstrap
# from: pen Z heights live OUTSIDE the repo, so without it a laptop silently
# seeds default profiles whose Z does not match the author's pens. See
# docs/LAPTOP-BOOTSTRAP.md section 4.
!docs/handoff/**/pen_profiles.json
# harness_env/vpype.toml is a fresh copy of ROOT/vpype.toml, made by
# start_server() on every harness run -- regenerable, not tracked.
scripts/harness_env/vpype.toml
.aider*

# Bake-off artifacts, 2026-08-01: exclude regenerable bulk, keep the evidence.
# *.pt        = diffusion latent caches (565MB), pure cache, no evidence value
# plotscale/  = display-only LANCZOS upscales (86MB); results.json records that
#               they add no source detail. Regenerable from raw/.
# atlas_build/patches/ = 354 superseded tile crops (43MB) from the tile-extraction
#               negative result; the finding lives in NEGATIVE_RESULT_tile_extraction.md
#               and screen_results.json, not the images.
artifacts/bakeoff-external-2026-07-31/**/*.pt
artifacts/bakeoff-external-2026-07-31/informative-drawings/plotscale/
artifacts/bakeoff-external-2026-07-31/stroke2sketch/atlas_build/patches/

# ── Laptop-handoff exclusions, 2026-08-06 ────────────────────────────────────
# Vendored upstream repos and virtualenvs that were cloned INSIDE artifacts/
# during the front-end bake-off: 3.5GB and 76k files in one directory. Its
# text evidence (results, contact sheet, notes) is kept via the un-ignore
# rules below; the checkout itself is reproducible from upstream.
artifacts/frontend-bakeoff-2026-08-03/**
!artifacts/frontend-bakeoff-2026-08-03/
!artifacts/frontend-bakeoff-2026-08-03/*.md
!artifacts/frontend-bakeoff-2026-08-03/*.json
!artifacts/frontend-bakeoff-2026-08-03/*.html
artifacts/**/.git/
artifacts/**/site-packages/
artifacts/**/node_modules/

# Model weights: multi-hundred-MB AND several are use-restricted (Anyline is
# CreativeML Open RAIL++-M, PhotoSketch weights are CC BY-NC-SA, the
# Informative Drawings weights are a third-party mirror). Re-download them,
# never redistribute them through this repo.
*.pth
*.ckpt
*.safetensors
*.onnx
*.bin

# Local disaster-recovery snapshots: full installed-app payloads and git
# bundles (~4GB). Meaningful only on the machine that made them. RESTORE.md
# from each is kept -- that is the part with information in it.
artifacts/recovery-*/**
!artifacts/recovery-*/
!artifacts/recovery-*/**/RESTORE.md
*.bundle

# Compiled extensions that came in with the vendored checkouts
*.dll
*.pyd

# Laptop bootstrap 2026-08-09: the venv lives in-repo but is machine-local.
.venv/
# Experiment harness server logs (regenerable; server.log above only caught
# the exact name -- sweeps write server2.log, server_combined.log, etc.)
artifacts/**/server*.log

# A local inference environment (multi-GB torch venv and use-restricted model weights) belongs
# outside the repository; ignored here so it can never be staged.
ccplotter-infer/

# 2026-08-19: experiment rounds copy scripts/harness_env into artifacts/<round>/_env/
# as a private hermetic env. ~2 GB per round (30 GB across the 2026-08-18/19 campaign),
# fully reproducible from scripts/harness_env. Never commit these.
artifacts/*/_env/

# 2026-08-19: each trace writes both a preview and a routed SVG; the preview is a
# near-duplicate of the routed geometry. Routed is the evidence, preview is not.
artifacts/*/svgs/*.preview.svg

# D938: per-run request provenance sidecars written into the (hermetic) harness runtime home
scripts/harness_env/run_provenance/
.venv-build311/
artifacts/ink-aware-twopen-2026-10-20/proto/**/*.np[yz]

# nolift preview 2026-10-21 big intermediates
artifacts/nolift-preview-2026-10-21/_env_*/
